# blossom developer keys. Copy to secrets.properties (gitignored) at the repo root.
# Every key is optional: a blank or missing key hides the feature that needs it.
# Values can also come from environment variables with the same name.

# untitled.stream sample links, comma-separated (only used for research and live tests).
UNTITLED_SAMPLE_LINKS=

# Google Drive sync (OAuth "Desktop app" client, drive.appdata scope).
GOOGLE_OAUTH_DESKTOP_CLIENT_ID=
GOOGLE_OAUTH_DESKTOP_CLIENT_SECRET=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=

# Dropbox sync (App folder access, PKCE).
DROPBOX_APP_KEY=

# Last.fm scrobbling.
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Discord Rich Presence (desktop).
DISCORD_APPLICATION_ID=
